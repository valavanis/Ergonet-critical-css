#!/bin/bash
# Κρατά το critical CSS συγχρονισμένο με το θέμα.
#
# ΓΙΑΤΙ ΥΠΑΡΧΕΙ: το critical CSS είναι στιγμιότυπο. Κάθε αλλαγή στο θέμα το κάνει
# λάθος, και η βλάβη είναι ΑΟΡΑΤΗ σε κάθε άλλο έλεγχο — το πλήρες stylesheet
# φορτώνει κανονικά, ο qt-css-guard δείχνει πράσινο, και το μόνο σύμπτωμα είναι μια
# σύντομη αναπήδηση στην πρώτη απόδοση που κανείς αυτόματος έλεγχος δεν βλέπει.
#
# Η ΣΚΑΝΔΑΛΗ ΕΙΝΑΙ ΤΟ ΠΕΡΙΕΧΟΜΕΝΟ, ΟΧΙ ΤΟ ΡΟΛΟΪ. Το bundle λέγεται
# standalone.<md5 περιεχομένου><timestamp>.css. Το timestamp αλλάζει σε ΚΑΘΕ
# καθάρισμα cache — αν σκανδάλιζε αυτό, θα ξαναχτίζαμε τζάμπα δεκάδες φορές τη
# μέρα. Τα πρώτα 32 hex είναι το md5 του περιεχομένου: αλλάζει μόνο όταν αλλάξει
# όντως το CSS. Ο έλεγχος κοστίζει ΕΝΑ αίτημα, οπότε τρέχει ωριαία και το παράθυρο
# παλαίωσης είναι το πολύ μία ώρα.
#
# Χρήση:
#   qt-critical-css              έλεγχος, και ξαναχτίσιμο αν χρειάζεται
#   qt-critical-css --force      ξαναχτίσιμο ό,τι κι αν λέει το hash
#   qt-critical-css --check      μόνο αναφορά, καμία εγγραφή
set -uo pipefail

SITE="${QT_CRIT_SITE:-https://qualitytoners.gr}"
DOCROOT=/var/www/qualitytoners.gr/public
ADDON="$DOCROOT/app/addons/ergonet_critical_css"
CSS="$ADDON/assets/critical.css"
HASHFILE="$ADDON/assets/critical.hash"
GEN="$(dirname "$0")/generate_critical.js"
NOTIFY="${QT_CRIT_NOTIFY:-$DOCROOT/var/qt-notify.php}"
LOG="${QT_CRIT_LOG:-/var/log/qt-critical-css.log}"
LOCK=/tmp/qt-critical-css.lock
GUARD=/usr/local/sbin/qt-css-guard

ts() { date '+%Y-%m-%d %H:%M:%S'; }
log() { echo "$(ts)  $*" >> "$LOG"; }

exec 9>"$LOCK"
flock -n 9 || { log "παραλείφθηκε: τρέχει ήδη"; exit 0; }

# ── Ποιο bundle σερβίρεται τώρα ───────────────────────────────────────────────
# Πραγματικός UA: το Cloudflare ενθέτει διαφορετικά ανά UA, και θέλουμε ό,τι
# βλέπει ο επισκέπτης.
HTML=$(curl -s --max-time 60 "$SITE/" \
    -H 'User-Agent: Mozilla/5.0 (Linux; Android 12; Pixel 5) AppleWebKit/537.36 Chrome/141 Mobile Safari/537.36')
# ΠΡΟΣΟΧΗ ΣΤΟ ΤΙ ΣΥΓΚΡΙΝΕΤΑΙ. Το όνομα είναι
#   standalone.<32 hex ταυτότητας θέματος><10ψήφιο timestamp>.css
# και η προηγούμενη εκδοχή έπαιρνε ΜΟΝΟ τα 32 hex. Εκείνα ΔΕΝ αλλάζουν όταν
# αλλάζει το ΠΕΡΙΕΧΟΜΕΝΟ του CSS — μόνο όταν αλλάζει το σύνολο των αρχείων.
#
# ΤΙ ΚΟΣΤΙΣΕ, μετρημένο 02/09/2026: δύο αλλαγές στυλ την ίδια μέρα (χρώματα
# μάρκας, font-display) πέρασαν και οι δύο απαρατήρητες. Το critical.css έμεινε
# παγωμένο στις 13:25 δηλώνοντας ακόμα `font-display: block` για τις FontAwesome
# ενώ το bundle είχε swap — δηλαδή η διόρθωση ήταν ζωντανή στο bundle και
# ΑΝΕΝΕΡΓΗ εκεί που μετράει, αφού το inline critical CSS κυβερνά την πρώτη
# απόδοση. Φάνηκε μόνο επειδή ο ιδιοκτήτης έστειλε χειρότερο FCP.
#
# Συγκρίνεται τώρα το ΠΕΡΙΕΧΟΜΕΝΟ. Κοστίζει ένα κατέβασμα ~80 KB την ώρα και
# απαντά στην πραγματική ερώτηση: «άλλαξε το CSS;» — όχι «άλλαξε το όνομα;».
BUNDLE_URL=$(printf '%s' "$HTML" | grep -oP 'href="\K[^"]*standalone\.[^"]*\.css[^"]*' | head -1)
BUNDLE=''
if [ -n "$BUNDLE_URL" ]; then
    BUNDLE=$(curl -s --max-time 60 "$BUNDLE_URL" | md5sum | cut -d' ' -f1)
fi
# Εφεδρεία: αν το κατέβασμα αποτύχει, γυρνάμε στο όνομα. Χειρότερος έλεγχος,
# αλλά ΠΟΤΕ σιωπηλή απώλεια του φύλακα.
if [ -z "$BUNDLE" ]; then
    BUNDLE=$(printf '%s' "$HTML" | grep -oP 'standalone\.\K[0-9a-f]+' | head -1)
    log "ΠΡΟΣΟΧΗ: το bundle δεν κατέβηκε — σύγκριση με το όνομα αντί για το περιεχόμενο"
fi

if [ -z "$BUNDLE" ]; then
    log "ΔΕΝ βρέθηκε bundle στο HTML — δεν αγγίζω τίποτα"
    exit 2
fi

OLD=$(cat "$HASHFILE" 2>/dev/null || echo '')
FORCE=0; [ "${1:-}" = "--force" ] && FORCE=1

if [ "${1:-}" = "--check" ]; then
    echo "  τρέχον hash θέματος: $BUNDLE"
    echo "  hash του critical:   ${OLD:-（κανένα）}"
    [ "$BUNDLE" = "$OLD" ] && echo "  ΣΥΓΧΡΟΝΙΣΜΕΝΟ" || echo "  ΠΑΛΙΩΜΕΝΟ — χρειάζεται ξαναχτίσιμο"
    exit 0
fi

if [ "$BUNDLE" = "$OLD" ] && [ "$FORCE" -eq 0 ]; then
    exit 0                                  # σιωπηλά: τρέχει ωριαία
fi

log "το θέμα άλλαξε: ${OLD:-κανένα} → $BUNDLE · ξαναχτίζω"

# ── Χτίσιμο σε προσωρινό, ΠΟΤΕ απευθείας πάνω από το ζωντανό ──────────────────
TMP=$(mktemp /tmp/critical.XXXXXX.css)
if ! node "$GEN" "$TMP" "$SITE" >>"$LOG" 2>&1; then
    log "ΑΠΕΤΥΧΕ το χτίσιμο — το ζωντανό critical.css ΔΕΝ πειράχτηκε"
    rm -f "$TMP"
    printf 'Το critical CSS χρειάζεται ξαναχτίσιμο (το θέμα άλλαξε) αλλά η γεννήτρια απέτυχε.\nΤο παλιό critical.css παραμένει ενεργό — η σελίδα δουλεύει, αλλά η πρώτη απόδοση\nμπορεί να δείχνει σύντομη αναπήδηση μέχρι να διορθωθεί.\n\nΈλεγχος: qt-critical-css --check\nΧειροκίνητα: qt-critical-css --force\n' \
        | sudo -u cscart-qt /usr/bin/php8.2 "$NOTIFY" "⚠ qualitytoners: το critical CSS δεν ξαναχτίστηκε" >/dev/null 2>&1
    exit 2
fi

# ── Εγκατάσταση με εφεδρικό ───────────────────────────────────────────────────
BAK="$CSS.$(date -u +%Y%m%dT%H%M%SZ).bak"
[ -f "$CSS" ] && cp -p "$CSS" "$BAK"
install -o cscart-qt -g cscart-qt -m 0644 "$TMP" "$CSS"
printf '%s' "$BUNDLE" > "$HASHFILE"
chown cscart-qt:cscart-qt "$HASHFILE"
rm -f "$TMP"
log "εγκαταστάθηκε: $(stat -c%s "$CSS") bytes (εφεδρικό: $(basename "$BAK"))"

# ── Οι σελίδες κουβαλούν το ΠΑΛΙΟ inline CSS μέχρι να ξαναχτιστούν ────────────
FPC_DIR="$DOCROOT/var/ergonet_rocket_cache"
# Μετράμε ΠΡΙΝ σβήσουμε: ο έλεγχος πρέπει να λέει πόσο κόστισε το ξαναχτίσιμο,
# αλλιώς είναι απλώς μια χρονοσφραγίδα.
PURGED=$(find "$FPC_DIR" -maxdepth 1 \( -name '*.html' -o -name '*.html.gz' \) 2>/dev/null | wc -l)
find "$FPC_DIR" -maxdepth 1 \( -name '*.html' -o -name '*.html.gz' \) -delete 2>/dev/null
rm -rf "$FPC_DIR/direct"/* 2>/dev/null

# Το σβήσιμο γίνεται από το filesystem ως root, εκτός PHP, οπότε ΔΕΝ περνά από
# την fn_ergonet_rocket_cache_audit_purge() ούτε γράφει τη σημαία. Χωρίς τις
# επόμενες γραμμές αυτή η διαδρομή είναι εντελώς αόρατη — 02/09/2026 έσβησε
# 1.658 σελίδες, ο έλεγχος δεν είχε καμία εγγραφή, και ο αυτόματος warmer δεν
# ενεργοποιήθηκε ποτέ. Ώρα Αθήνας, για να είναι μία σειρά με τις PHP εγγραφές.
NOW=$(TZ=Europe/Athens date --iso-8601=seconds)
printf '%s mode=all deleted=%s sapi=cli origin=cron | /usr/local/sbin/qt-critical-css (ανακατασκευή critical CSS: %s -> %s)\n' \
    "$NOW" "$PURGED" "${OLD:-κανένα}" "$BUNDLE" >> "$DOCROOT/var/ergonet_rocket_cache_purge_audit.log"

# Η σημαία που διαβάζει ο qt-fpc-warm-after-deploy κάθε λεπτό. Ίδια διαδρομή με
# την fn_ergonet_rocket_cache_audit_purge() — αν αλλάξει εκεί, αλλάζει κι εδώ.
printf '{"at":"%s","type":"critical_css","extra":"qt-critical-css","deleted":%s}\n' \
    "$NOW" "$PURGED" > "$FPC_DIR/.needs-warm"
chown cscart-qt:cscart-qt "$FPC_DIR/.needs-warm"
log "σβήστηκαν $PURGED σελίδες FPC · σημαία ξαναζεστάματος γράφτηκε"
# Το Cloudflare μέσω της ουράς του rocket cache — τα διαπιστευτήρια είναι εκτός
# open_basedir, οπότε το γράψιμο στην ουρά είναι ο μόνος δρόμος από PHP.
cd "$DOCROOT" && sudo -u cscart-qt /usr/bin/php8.2 -r '
define("AREA","A"); define("ACCOUNT_TYPE","admin"); require "init.php";
if (function_exists("fn_ergonet_rocket_cache_cf_collect")) {
    fn_ergonet_rocket_cache_cf_collect(ERGONET_RC_CF_PURGE_ALL);
    fn_ergonet_rocket_cache_cf_flush();
}' >/dev/null 2>&1 && log "CF purge στην ουρά"

# ── Επαλήθευση ΑΠΟΔΟΣΗΣ, όχι πρόθεσης ────────────────────────────────────────
sleep 5
if [ -x "$GUARD" ] && ! "$GUARD" --json >/dev/null 2>&1; then
    log "ΠΡΟΣΟΧΗ: ο φύλακας CSS πέφτει μετά το ξαναχτίσιμο"
    printf 'Το critical CSS ξαναχτίστηκε αλλά ο φύλακας CSS αναφέρει πρόβλημα.\nΕπαναφορά: cp %s %s\n' "$BAK" "$CSS" \
        | sudo -u cscart-qt /usr/bin/php8.2 "$NOTIFY" "⚠ qualitytoners: ο φύλακας CSS πέφτει μετά το ξαναχτίσιμο" >/dev/null 2>&1
    exit 1
fi

log "ΟΚ — critical συγχρονισμένο με $BUNDLE"
exit 0
